{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duinlab-today",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  // the Astro handler plus the hourly refresh of the day (src/worker.ts)
  "main": "./src/worker.ts",
  "triggers": { "crons": ["5 * * * *"] },
  // a public day mirror and the weekly agenda; canonical days live in the coordinator
  "kv_namespaces": [{ "binding": "DAYS", "id": "300b6192395a4909abf0b46357156964" }],
  "durable_objects": {
    "bindings": [{ "name": "DAY_COORDINATOR", "class_name": "DayCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DayCoordinator"] }],
  "routes": [{ "pattern": "today.duinlab.nl", "custom_domain": true }],
  // the deploy check reads this URL: the zone's bot challenge answers datacenter IPs with 403
  "workers_dev": true,
  "env": {
    // Pull request previews (ts.yml), deployed as duinlab-today-pr-<number> and built with
    // PREVIEW set, so fixtures answer every source. No cron and no custom domain. The KV
    // binding has no id: the first deploy creates duinlab-today-pr-<number>-days, and
    // preview-retire.yml deletes it with the Worker.
    "preview": {
      "triggers": { "crons": [] },
      "routes": [],
      "workers_dev": true,
      "kv_namespaces": [{ "binding": "DAYS" }],
      "durable_objects": {
        "bindings": [{ "name": "DAY_COORDINATOR", "class_name": "DayCoordinator" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DayCoordinator"] }]
    }
  }
}
