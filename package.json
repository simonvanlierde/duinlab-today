{
  "name": "duinlab-today",
  "version": "0.2.0",
  "description": "A daily paper for The Hague with pictures, sourced facts, weather, a quiz and web games, under a sky that follows the real sun.",
  "license": "MIT",
  "author": "Simon van Lierde <code@duinlab.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonvanlierde/duinlab-today.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "types": "wrangler types src/lib/worker-configuration.d.ts",
    "build": "pnpm run types && astro build",
    "preview": "wrangler dev",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "pnpm run types && astro check && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=text",
    "test:e2e": "playwright test",
    "licenses": "pnpm licenses list --prod --json | node scripts/checkLicenses.mjs",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/svelte": "9.1.6",
    "astro": "7.4.13",
    "astronomy-engine": "2.1.19",
    "entities": "9.0.0",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.8",
    "@j178/prek": "^0.5.7",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "smol-toml": "1.9.1",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
