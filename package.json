{
	"name": "duinlab-today",
	"type": "module",
	"version": "0.1.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"types": "wrangler types src/lib/worker-configuration.d.ts",
		"build": "pnpm run types && astro build",
		"preview": "wrangler dev",
		"check": "pnpm run types && biome check . && astro check",
		"test": "vitest run",
		"e2e": "playwright test",
		"licenses": "pnpm licenses list --prod --json | node scripts/checkLicenses.mjs",
		"deploy": "pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.3",
		"@astrojs/svelte": "9.1.2",
		"astro": "7.4.7",
		"astronomy-engine": "2.1.19",
		"svelte": "5.57.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"typescript": "6.0.3",
		"vitest": "4.1.12",
		"wrangler": "4.156.1"
	},
	"packageManager": "pnpm@12.17.0"
}
