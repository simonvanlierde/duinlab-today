{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!.vscode"] },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "overrides": [
    {
      "includes": ["**/*.svelte", "**/*.astro"],
      "linter": {
        "rules": {
          "style": { "useConst": "off", "useImportType": "off" },
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
        }
      }
    }
  ],
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true }
}
