---
import Cue from "../components/Cue.astro";
import Dune from "../components/Dune.astro";
import Foot from "../components/Foot.astro";
import Games from "../components/Games.svelte";
import Pictures from "../components/Pictures.astro";
import Quiz from "../components/Quiz.svelte";
import { bodiesAt, moonPath, PHASE_SUN, saturation } from "../components/sky";
import Base from "../layouts/Base.astro";
import { forecastUrl, site } from "../lib/config";
import { clock, longDate, rainLine, sunLines, temperature, temperatureUnit, weekday, windLine } from "../lib/format";
import { moonNow, planetsAt, starNow } from "../lib/moon";
import { moonTimes } from "../lib/moon-times";
import { occasionLine } from "../lib/occasions";
import { planetPositions, planetsTonight } from "../lib/planets";
import { previewEvents } from "../lib/sources/events";
import { PHASES, phaseAt, type SkyPhase, sunAltitude } from "../lib/sun";
import { getToday } from "../lib/today";

const now = new Date();
let today: Awaited<ReturnType<typeof getToday>>;
try {
  today = await getToday(now);
} catch (err) {
  // the first read of a day can fail on KV or the coordinator; the next request retries
  console.warn(`front page failed: ${err}`);
  return new Response("Today's page is unavailable for a moment. Try again in half a minute.", {
    status: 503,
    headers: { "content-type": "text/plain; charset=utf-8", "retry-after": "30", "cache-control": "no-store" },
  });
}
const asked = Astro.url.searchParams.get("phase");
const forced = PHASES.includes(asked as SkyPhase);
const phase = forced ? (asked as SkyPhase) : phaseAt(today.sun, now.getTime());
const { pictures, word, quote, quiz, weather, onThisDay } = today;
const sea = today.sea;
// days stored before the featured article existed have no such key
const featured = today.featured ?? null;
const tides = today.tides ?? null;
const events = today.events?.items.length ? today.events : null;
const eventPreview = previewEvents(events?.items ?? []);
const eventMore = events?.items.filter((e) => !eventPreview.includes(e)) ?? [];
const tideTimes = (kind: "high" | "low") =>
  (tides?.events ?? [])
    .filter((e) => e.kind === kind)
    .map((e) => e.at)
    .join(" and ");
const rain = weather ? rainLine(weather.rainNext2h, now, weather.rainCredit.name === "Open-Meteo" ? 15 : 5) : "";
const fact = today.didYouKnow[0];
const heading = longDate(today.date);
const hasQuiz = !!quiz && quiz.questions.length > 0;
const almanac = sunLines(today);
const moon = moonTimes(today.date);
// the moon, sun and star where they are right now; the sky script keeps them current
const planets = planetPositions(now);
const tonight = planetsTonight(today.date, now);
const bodies = bodiesAt(
  today.sun,
  now.getTime(),
  forced ? PHASE_SUN[phase].alt : sunAltitude(now.getTime(), site.location.latitude, site.location.longitude),
  (t) => moonNow(t, site.location.latitude, site.location.longitude),
  (t) => starNow(t, site.location.latitude, site.location.longitude),
  (t) => planetsAt(planets, t, site.location.latitude, site.location.longitude),
);
const orb = (b: { x: number; alt: number }) => `--x:${b.x.toFixed(4)};--alt:${b.alt.toFixed(2)}`;
const occasion = occasionLine(today.date);
const SKY_EVENTS = `https://www.timeanddate.com/astronomy/@${site.location.latitude},${site.location.longitude}`;
const HOLIDAYS =
  "https://calendar.google.com/calendar/embed?src=en.dutch%23holiday%40group.v.calendar.google.com&ctz=Europe%2FAmsterdam";
const what = site.site.description;
---

<Base
	today={today}
	phase={phase}
	forced={forced}
	saturation={saturation(weather)}
	planets={planets}
	title={`${site.site.title} - ${heading}`}
	description={what}
>
	<a class="skip" href="#paper">Skip to the paper</a>
	<header class="sky">
		<div class="wrap mast">
			<div>
				<div class="date-time"><h1>{heading}</h1><time data-clock>{clock(now)}</time></div>
				{
					occasion && (
						<p class="occasion">
							<a href={occasion.sky ? SKY_EVENTS : HOLIDAYS} title={occasion.sky ? `Sky events in ${site.location.name} on timeanddate.com` : "Dutch holidays on Google Calendar"}>{occasion.text}<span class="sr"> ({occasion.sky ? "Sky events on timeanddate.com" : "Dutch holidays on Google Calendar"})</span></a>
						</p>
					)
				}
			</div>
			{
				weather && (
					<ul class="plain strip">
						<li>
							<a class="wx" href={forecastUrl} title={`${windLine(weather.now)}. The week ahead on meteoblue`}>
								<span class="temp">{temperature(weather.now.temperatureC)}{site.units.temperature === "fahrenheit" ? "°F" : <>°<span class="sr">C</span></>}</span>
								{` ${weather.now.description}, ${temperature(weather.today.maxC)}° / ${temperature(weather.today.minC)}° · wind ${weather.now.windFrom} ${weather.now.windBeaufort}`}
								<span class="sr">. {windLine(weather.now)}. The week ahead on meteoblue</span>
							</a>
							{rain && (
								<>
									{" · "}
									<a href={(weather.rainCredit ?? weather.credit).url} title={`Rain radar: ${(weather.rainCredit ?? weather.credit).name}`}>
										{rain.toLowerCase()}
										<span class="sr"> (rain radar: {(weather.rainCredit ?? weather.credit).name})</span>
									</a>
								</>
							)}
							{weather.air && (
								<>
									{" · "}
									<a href="https://open-meteo.com/en/docs/air-quality-api" title="Air quality and pollen: Open-Meteo">{weather.air}<span class="sr"> (Open-Meteo)</span></a>
								</>
							)}
						</li>
					</ul>
				)
			}
		</div>
		<button class="orb sun" type="button" popovertarget="almanac" data-orb="sun" hidden={!bodies.sun.show} style={orb(bodies.sun)} aria-label="Sun: sun and moon times"></button>
		<button class="orb moon" type="button" popovertarget="almanac" data-orb="moon" data-moon-label hidden={!bodies.moon.show} style={orb(bodies.moon)} aria-label={`${bodies.moon.label}: sun and moon times`}>
			<svg viewBox="0 0 18 18" width="26" height="26" aria-hidden="true">
				<circle cx="9" cy="9" r="8.6" fill="currentColor" opacity=".16" />
				<path data-moon-path d={moonPath(bodies.moon, 9)} fill="currentColor" />
			</svg>
		</button>
		<button class="orb star" type="button" popovertarget="almanac" data-orb="star" data-star-label hidden={!bodies.star.show} style={orb(bodies.star)} aria-label={`${bodies.star.name}: sun and moon times`}></button>
		{
			bodies.planets.map((p) => (
				<button class="orb planet" type="button" popovertarget="almanac" data-planet={p.name} hidden={!p.show} style={orb(p)} aria-label={`${p.name}: planets, sun and moon times`}>
					<span class="pt"></span><span class="tag" aria-hidden="true">{p.name}</span>
				</button>
			))
		}
		<div id="almanac" class="almanac" popover role="region" aria-labelledby="almanac-title">
			<div class="almanac-head">
				<h2 id="almanac-title" tabindex="-1">Almanac</h2>
				<button type="button" popovertarget="almanac" popovertargetaction="hide">Close</button>
			</div>
			<div class="almanac-details">
				<div class="almanac-selected" hidden></div>
				<section class="almanac-group" aria-labelledby="almanac-sun-moon">
					<h3 id="almanac-sun-moon">Sun and moon</h3>
					<div data-almanac-body="sun" data-almanac-name="Sun">
						<p>Sunrise <b>{almanac.sunrise}</b>, sunset <b>{almanac.sunset}</b></p>
						<p>Golden hour from <b>{almanac.golden}</b></p>
						<p>{almanac.daylight}</p>
					</div>
					<div data-almanac-body="moon" data-almanac-name="Moon">
						<p data-moon-line>{bodies.moon.line}</p>
						<p>{moon.rise ? <>Moonrise <b>{clock(moon.rise)}</b></> : "No moonrise today"}</p>
						<p>{moon.set ? <>Moonset <b>{clock(moon.set)}</b></> : "No moonset today"}</p>
					</div>
					<div data-almanac-body="star" data-almanac-name="Star" hidden={!bodies.star.show}>
						<p data-star-line>{bodies.star.name}, {Math.round(bodies.star.alt)}° above the horizon</p>
					</div>
				</section>
				<section class="almanac-group" aria-labelledby="almanac-planets" hidden={!tonight.length}>
					<h3 id="almanac-planets">Planets tonight</h3>
					{bodies.planets.map((planet) => {
						const window = tonight.find((item) => item.name === planet.name);
						return (
							<div data-almanac-body={planet.name} data-almanac-name={planet.name} hidden={!window}>
								<p class="planet-window"><b class="planet-name">{planet.name}</b>{" "}<span class="planet-observing">{window ? window.line.slice(planet.name.length + 1) : "No remaining observing window tonight."}</span></p>
							</div>
						);
					})}
				</section>
				{(tides || sea) && (
					<section class="almanac-group" aria-labelledby="almanac-sea">
						<h3 id="almanac-sea">At Scheveningen</h3>
						{tides && (
							<p>
								High water <b>{tideTimes("high")}</b>, low <b>{tideTimes("low")}</b> at{" "}
								<a href={tides.url}>Scheveningen</a>
							</p>
						)}
						{sea && (
							<p>
								Water{" "}
								<b>{[sea.temperatureC !== null && `${temperature(sea.temperatureC, 1).toFixed(1)} ${temperatureUnit}`, sea.waveHeightM !== null && `waves ${sea.waveHeightM.toFixed(1)} m`].filter(Boolean).join(", ")}</b>{" "}
								<span class="src"><a href={sea.credit.url}>{sea.credit.name}</a></span>
							</p>
						)}
					</section>
				)}
			</div>
		</div>
		<Dune />
	</header>

	<main class="wrap front" id="paper">
		{pictures.length > 0 && <Pictures pictures={pictures} />}
		<div class="reading">
			{
				fact && (
					<section class="sec" aria-labelledby="h-dyk">
						<Cue id="h-dyk">Did you know</Cue>
						<p class="fact">
							<span class="that">&hellip; that</span> {fact.text}{" "}
							<span class="src"><a href={fact.url}>{fact.credit.name}</a></span>
						</p>
					</section>
				)
			}
			{
				word && (
					<section class="sec" aria-labelledby="h-word">
						<Cue id="h-word" sr>Word</Cue>
						<p>
							<strong class="word" lang="en">{word.word}</strong>{" "}
							{word.partOfSpeech && <><em class="pos">{word.partOfSpeech}</em>{" "}</>}
							{word.gloss}{" "}
							<span class="src"><a href={word.url}>{word.credit.name}</a></span>
						</p>
					</section>
				)
			}
			{
				hasQuiz && (
					<section class="sec quiz" aria-labelledby="h-quiz">
						<Quiz client:load quiz={quiz} />
						<noscript>
							<h2 class="cue">Quiz</h2>
							<ol class="quiz-static">
								{quiz.questions.map((q) => (
									<li>
										<p>{q.question}</p>
										<p class="mute">{q.answers.join(" · ")}</p>
										<details>
											<summary>Show the answer</summary>
											<p>{q.answers[q.correct]}</p>
										</details>
									</li>
								))}
							</ol>
							<p class="src"><a href={quiz.credit.url}>{quiz.credit.name}</a></p>
						</noscript>
					</section>
				)
			}
		</div>
		{
			today.games.length > 0 && (
				<section class="rail" aria-labelledby="h-games">
					<Games client:load games={today.games} />
					<p class="the-end" aria-live="polite">
						Tomorrow's sunrise: {almanac.nextSunrise}.
					</p>
				</section>
			)
		}
		{
			featured && (
				<section class="sec feat" aria-labelledby="h-featured">
					<Cue id="h-featured" sr>Featured article</Cue>
					<p>
						<a href={featured.url}><strong>{featured.title}</strong></a>. {featured.extract}{" "}
						<span class="src"><a href={featured.credit.url}>{featured.credit.name}</a></span>
					</p>
				</section>
			)
		}
		{
			onThisDay && (
				<section class="sec otd" aria-labelledby="h-otd">
					<Cue id="h-otd">On this day</Cue>
					<p>
						<strong class="year">{onThisDay.year}</strong> {onThisDay.text}{" "}
						<span class="src"><a href={onThisDay.url}>{onThisDay.credit.name}</a></span>
					</p>
				</section>
			)
		}
		{
			quote && (
				<figure class="quote">
					<blockquote>&ldquo;{quote.text}&rdquo;</blockquote>
					<figcaption>
						{quote.author}{" "}
						<span class="src"><a href={quote.credit.url}>{quote.credit.name}</a></span>
					</figcaption>
				</figure>
			)
		}
	</main>

	<div class="wrap extras">
	{
		today.recipes.length > 0 && (
			<section class="recipes" aria-labelledby="h-recipes">
				<Cue id="h-recipes">Recipes</Cue>
				<ul class="plain">
					{today.recipes.slice(0, 3).map((r) => (
						<li>
							<span class="paper">{r.source}</span>{" "}<a href={r.url}>{r.title}</a>
						</li>
					))}
				</ul>
				{today.recipes.length > 3 && (
					<details class="more">
						<summary>More recipes</summary>
						<ul class="plain">
							{today.recipes.slice(3).map((r) => (
								<li><span class="paper">{r.source}</span>{" "}<a href={r.url}>{r.title}</a></li>
							))}
						</ul>
					</details>
				)}
			</section>
		)
	}

	{
		events && (
			<section class="local" aria-labelledby="h-events">
				<Cue id="h-events">This week in {site.location.name}</Cue>
				<ul class="plain">
					{eventPreview.map((e) => (
						<li>
							<span class="when">{weekday(e.day, today.date)}{e.time && ` ${e.time}`}</span>{" "}
							<a href={e.url}>{e.name}</a>{" "}<span class="mute">{e.venue}</span>
						</li>
					))}
				</ul>
				{eventMore.length > 0 && (
					<details class="more">
						<summary>More events</summary>
						<ul class="plain">
							{eventMore.map((e) => (
								<li><span class="when">{weekday(e.day, today.date)}{e.time && ` ${e.time}`}</span>{" "}<a href={e.url}>{e.name}</a>{" "}<span class="mute">{e.venue}</span></li>
							))}
						</ul>
					</details>
				)}
				<p class="src"><a href={events.url}>{events.credit.name}</a></p>
			</section>
		)
	}

	</div>

	<Foot><a href="/yesterday">Yesterday's paper</a> &middot; <a href="/about">About</a> &middot;</Foot>
	<script>
		const almanac = document.querySelector<HTMLElement>("#almanac");
		const title = almanac?.querySelector<HTMLElement>("#almanac-title");
		const details = almanac?.querySelector(".almanac-details");
		const selectedSlot = details?.querySelector<HTMLElement>(".almanac-selected");
		if (almanac && title && details && selectedSlot) {
			const sections = [...details.querySelectorAll<HTMLElement>("[data-almanac-body]")];
			const homes = sections.map((section) => ({ section, parent: section.parentElement! }));
			const groups = [...details.querySelectorAll<HTMLElement>(".almanac-group")].filter((group) => group.querySelector("[data-almanac-body]"));
			const unavailable = new Set(sections.filter((section) => section.hidden));
			for (const button of document.querySelectorAll<HTMLElement>('button[popovertarget="almanac"]:not([popovertargetaction="hide"])')) {
				button.addEventListener("click", () => {
					for (const section of sections) section.hidden = section.dataset.almanacBody === "star" || unavailable.has(section);
					for (const { section, parent } of homes) parent.appendChild(section);
					const key = button.dataset.planet ?? button.dataset.orb;
					const selected = sections.find((section) => section.dataset.almanacBody === key);
					if (selected) {
						selected.hidden = false;
						selectedSlot.appendChild(selected);
					}
					selectedSlot.hidden = !selected;
					for (const group of groups) {
						group.hidden = ![...group.querySelectorAll<HTMLElement>("[data-almanac-body]")].some((section) => !section.hidden);
					}
					title.textContent = selected?.dataset.almanacName ?? "Almanac";
				});
			}
			almanac.addEventListener("toggle", (event) => {
				if ((event as ToggleEvent).newState !== "open") return;
				almanac.scrollTop = 0;
				title.focus({ preventScroll: true });
			});
		}
	</script>
</Base>
