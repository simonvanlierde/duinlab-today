---
import Cue from "../components/Cue.astro";
import Dune from "../components/Dune.astro";
import Foot from "../components/Foot.astro";
import Games from "../components/Games.svelte";
import Pictures from "../components/Pictures.astro";
import Quiz from "../components/Quiz.svelte";
import {
	bodiesAt,
	moonPath,
	PHASE_LABEL,
	PHASE_LINE,
	PHASE_SUN,
	saturation,
} from "../components/sky";
import Base from "../layouts/Base.astro";
import {
	clock,
	longDate,
	rainLine,
	sunLines,
	weekday,
	windLine,
} from "../lib/format";
import { moonNow, planetsAt, starNow } from "../lib/moon";
import { occasionLine } from "../lib/occasions";
import { planetPositions, planetsTonight } from "../lib/planets";
import { PHASES, phaseAt, type SkyPhase, sunAltitude } from "../lib/sun";
import { getToday } from "../lib/today";

const now = new Date();
const today = await getToday(now);
const asked = Astro.url.searchParams.get("phase");
const forced = PHASES.includes(asked as SkyPhase);
const phase = forced ? (asked as SkyPhase) : phaseAt(today.sun, now.getTime());
const { pictures, word, quote, quiz, weather, onThisDay } = today;
const sea = today.sea;
// days stored before the featured article existed have no such key
const featured = today.featured ?? null;
const tides = today.tides ?? null;
const events = today.events?.items.length ? today.events : null;
const tideTimes = (kind: "high" | "low") =>
	(tides?.events ?? [])
		.filter((e) => e.kind === kind)
		.map((e) => e.at)
		.join(" and ");
const rain = weather ? rainLine(weather.rainNext2h) : "";
const fact = today.didYouKnow[0];
const heading = longDate(today.date);
const hasQuiz = !!quiz && quiz.questions.length > 0;
const FORECAST =
	"https://www.meteoblue.com/en/weather/week/the-hague_netherlands_2747373";
const almanac = sunLines(today);
// the moon, sun and star where they are right now; the sky script keeps them current
const planets = planetPositions(now);
const planetsLine = planetsTonight(today.date, now);
const bodies = bodiesAt(
	today.sun,
	now.getTime(),
	forced ? PHASE_SUN[phase].alt : sunAltitude(now.getTime()),
	moonNow,
	starNow,
	(t) => planetsAt(planets, t),
);
const orb = (b: { x: number; alt: number }) =>
	`--x:${b.x.toFixed(4)};--alt:${b.alt.toFixed(2)}`;
const occasion = occasionLine(today.date);
const SKY_EVENTS =
	"https://www.timeanddate.com/astronomy/netherlands/the-hague";
const HOLIDAYS =
	"https://calendar.google.com/calendar/embed?src=en.dutch%23holiday%40group.v.calendar.google.com&ctz=Europe%2FAmsterdam";
const what = `A small daily page: a few pictures, sourced facts, a word, a quiz and ${today.games.length} daily games.`;
---

<Base
	today={today}
	phase={phase}
	forced={forced}
	saturation={saturation(weather)}
	planets={planets}
	title={`today.duinlab.nl - ${heading}`}
	description={what}
>
	<a class="skip" href="#paper">Skip to the paper</a>
	<p class="bar">
		<span class="wrap bar-in">
			<span><span data-clock>{clock(now)}</span> &middot; <span data-phase-label>{PHASE_LABEL[phase]}</span><span data-progress></span></span>
			<span class="mode" role="group" aria-label="How much of the paper">
				<button type="button" data-mode-set="coffee" aria-pressed="true" title="The whole paper">Coffee</button>
				<button type="button" data-mode-set="train" aria-pressed="false" title="The weather, one fact and the games">Train</button>
			</span>
		</span>
	</p>
	<header class="sky">
		<div class="wrap mast">
			<div>
				<h1>{heading}</h1>
				<p class="greet" data-phase-line>{PHASE_LINE[phase]}</p>
				{
					occasion && (
						<p class="occasion">
							<a href={occasion.sky ? SKY_EVENTS : HOLIDAYS} title={occasion.sky ? "Sky events in The Hague on timeanddate.com" : "Dutch holidays on Google Calendar"}>{occasion.text}<span class="sr"> ({occasion.sky ? "Sky events on timeanddate.com" : "Dutch holidays on Google Calendar"})</span></a>
						</p>
					)
				}
			</div>
			{
				weather && (
					<ul class="plain strip">
						<li>
							<a class="wx" href={FORECAST} title={`${windLine(weather.now)}. The week ahead on meteoblue`}>
								<span class="temp">{Math.round(weather.now.temperatureC)}&deg;</span>
								{` ${weather.now.description}, ${Math.round(weather.today.maxC)}° / ${Math.round(weather.today.minC)}° · wind ${weather.now.windFrom} ${weather.now.windBeaufort}`}
								<span class="sr">. {windLine(weather.now)}. The week ahead on meteoblue</span>
							</a>
							{rain && (
								<>
									{" · "}
									<a href={(weather.rainCredit ?? weather.credit).url} title={`Rain radar: ${(weather.rainCredit ?? weather.credit).name}`}>
										{rain.toLowerCase()}
										<span class="sr"> (rain radar: {(weather.rainCredit ?? weather.credit).name})</span>
									</a>
								</>
							)}
							{weather.air && (
								<>
									{" · "}
									<a href="https://open-meteo.com/en/docs/air-quality-api" title="Air quality and pollen: Open-Meteo">{weather.air}<span class="sr"> (Open-Meteo)</span></a>
								</>
							)}
						</li>
					</ul>
				)
			}
		</div>
		<button class="orb sun" type="button" popovertarget="almanac" data-orb="sun" hidden={!bodies.sun.show} style={orb(bodies.sun)} aria-label="Sun: sun, moon and tide times"></button>
		<button class="orb moon" type="button" popovertarget="almanac" data-orb="moon" data-moon-label hidden={!bodies.moon.show} style={orb(bodies.moon)} aria-label={`${bodies.moon.label}: sun, moon and tide times`}>
			<svg viewBox="0 0 18 18" width="26" height="26" aria-hidden="true">
				<circle cx="9" cy="9" r="8.6" fill="currentColor" opacity=".16" />
				<path data-moon-path d={moonPath(bodies.moon, 9)} fill="currentColor" />
			</svg>
		</button>
		<button class="orb star" type="button" popovertarget="almanac" data-orb="star" data-star-label hidden={!bodies.star.show} style={orb(bodies.star)} aria-label={`${bodies.star.name}: sun, moon and tide times`}></button>
		{
			bodies.planets.map((p) => (
				<button class="orb planet" type="button" popovertarget="almanac" data-planet={p.name} hidden={!p.show} style={orb(p)} aria-label={`${p.name}: planets, sun, moon and tide times`}>
					<span class="pt"></span><span class="tag" aria-hidden="true">{p.name}</span>
				</button>
			))
		}
		<div id="almanac" class="almanac" popover>
			<p>Sun up <b>{almanac.sunrise}</b>, down <b>{almanac.sunset}</b></p>
			<p>Golden hour from <b>{almanac.golden}</b></p>
			<p>{almanac.daylight}</p>
			<p data-moon-line>{bodies.moon.line}</p>
			{planetsLine && <p>Tonight: {planetsLine}</p>}
			{
				tides && (
					<p>
						High water <b>{tideTimes("high")}</b>, low <b>{tideTimes("low")}</b> at{" "}
						<a href={tides.url}>Scheveningen</a>
					</p>
				)
			}
			{
				sea && (
					<p>
						Sea at Scheveningen{" "}
						<b>{[sea.temperatureC !== null && `${sea.temperatureC.toFixed(1)} °C`, sea.waveHeightM !== null && `waves ${sea.waveHeightM.toFixed(1)} m`].filter(Boolean).join(", ")}</b>{" "}
						<span class="src"><a href={sea.credit.url}>{sea.credit.name}</a></span>
					</p>
				)
			}
		</div>
		<Dune />
	</header>

	<main class="wrap front" id="paper">
		{
			today.games.length > 0 && (
				<section class="rail" aria-labelledby="h-games">
					<Games client:load games={today.games} />
					<p class="the-end" aria-live="polite">
						That's the paper. The sun is back at {almanac.nextSunrise} tomorrow.
					</p>
				</section>
			)
		}
		{pictures.length > 0 && <Pictures pictures={pictures} />}
			{
				featured && (
					<section class="sec feat" aria-labelledby="h-featured">
						<Cue id="h-featured">Featured article</Cue>
						<p>
							<a href={featured.url}><strong>{featured.title}</strong></a>. {featured.extract}{" "}
							<span class="src"><a href={featured.credit.url}>{featured.credit.name}</a></span>
						</p>
					</section>
				)
			}
		<div class="reading">
			{
				fact && (
					<section class="sec" aria-labelledby="h-dyk">
						<Cue id="h-dyk">Did you know</Cue>
						<p class="fact">
							<span class="that">&hellip; that</span> {fact.text}{" "}
							<span class="src"><a href={fact.url}>{fact.credit.name}</a></span>
						</p>
					</section>
				)
			}
			{
				word && (
					<section class="sec" aria-labelledby="h-word">
						<Cue id="h-word">Word</Cue>
						<p>
							<strong class="word" lang="en">{word.word}</strong>
							{word.partOfSpeech && <em class="pos">{word.partOfSpeech}</em>}
							{word.gloss}{" "}
							<span class="src"><a href={word.url}>{word.credit.name}</a></span>
						</p>
					</section>
				)
			}
			{
				hasQuiz && (
					<section class="sec quiz" aria-labelledby="h-quiz">
						<Quiz client:load quiz={quiz} />
						<noscript>
							<h2 class="cue">Quiz</h2>
							<ol class="quiz-static">
								{quiz.questions.map((q) => (
									<li>
										<p>{q.question}</p>
										<p class="mute">{q.answers.join(" · ")}</p>
										<details>
											<summary>Show the answer</summary>
											<p>{q.answers[q.correct]}</p>
										</details>
									</li>
								))}
							</ol>
							<p class="src"><a href={quiz.credit.url}>{quiz.credit.name}</a></p>
						</noscript>
					</section>
				)
			}
		</div>
		{
			onThisDay && (
				<section class="sec otd" aria-labelledby="h-otd">
					<Cue id="h-otd">On this day</Cue>
					<p>
						<strong class="year">{onThisDay.year}</strong> {onThisDay.text}{" "}
						<span class="src"><a href={onThisDay.url}>{onThisDay.credit.name}</a></span>
					</p>
				</section>
			)
		}
		{
			quote && (
				<figure class="quote">
					<blockquote>&ldquo;{quote.text}&rdquo;</blockquote>
					<figcaption>
						{quote.author}{" "}
						<span class="src"><a href={quote.credit.url}>{quote.credit.name}</a></span>
					</figcaption>
				</figure>
			)
		}
	</main>

	{
		today.recipes.length > 0 && (
			<section class="wrap recipes" aria-labelledby="h-recipes">
				<Cue id="h-recipes">Recipes</Cue>
				<ul class="plain">
					{today.recipes.map((r) => (
						<li>
							<span class="paper">{r.source}</span> <a href={r.url}>{r.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		events && (
			<section class="wrap local" aria-labelledby="h-events">
				<Cue id="h-events">This week at {events.credit.name}</Cue>
				<ul class="plain">
					{events.items.map((e) => (
						<li>
							<span class="when">{weekday(e.day, today.date)}{e.time && ` ${e.time}`}</span>{" "}
							<a href={e.url}>{e.name}</a>
						</li>
					))}
				</ul>
				<p class="src"><a href={events.url}>{events.credit.name}</a></p>
			</section>
		)
	}

	<Foot>New every midnight. <a href="/yesterday">Yesterday's paper</a> &middot; <a href="/about">About</a> &middot;</Foot>
</Base>
