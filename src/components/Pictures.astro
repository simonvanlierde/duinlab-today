---
import type { Picture } from "../lib/types";
import Cue from "./Cue.astro";

interface Props {
  pictures: Picture[];
}
const { pictures } = Astro.props;
---

<section class="pic" aria-labelledby="h-picture">
	<Cue id="h-picture" sr>Pictures</Cue>
	<div class="reel">
		<div
			class="slides"
			role="region"
			aria-label={`Pictures of the day, ${pictures.length}`}
			tabindex="0"
			data-slides
		>
			{
				pictures.map((p, i) => (
					<figure class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${pictures.length}`}>
						<a class="picture-open" href={p.fullImageUrl ?? p.imageUrl} aria-label={`Look closer: ${p.title}`}>
							<img
								src={p.imageUrl}
								alt={p.alt}
								width={p.width ?? undefined}
								height={p.height ?? undefined}
								loading={i === 0 ? "eager" : "lazy"}
								fetchpriority={i === 0 ? "high" : undefined}
								decoding="async"
							/>
							<span class="picture-hint" aria-hidden="true">Look closer</span>
						</a>
						<figcaption>
							<span class="picture-credit">
								<a href={p.pageUrl}><em>{p.title}</em></a>
								{p.by && <>, {p.by}</>}
								{p.date && <>, {p.date}</>}.{" "}
								<span class="src"><a href={p.credit.url}>{p.credit.name}</a></span>
							</span>
							{p.explanation && <details class="picture-explanation">
								<summary>About this picture</summary>
								<p>{p.explanation}</p>
							</details>}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<dialog class="picture-viewer" aria-label="Picture viewer">
	<div class="viewer-tools">
		<span class="viewer-count" aria-live="polite"></span>
		<button type="button" data-viewer-zoom>Zoom in</button>
		<button type="button" data-viewer-close aria-label="Close viewer">Close</button>
	</div>
	<figure class="viewer-figure">
		<div class="viewer-stage" role="region" aria-label="Enlarged picture" tabindex="0">
			{
				// draggable: a mouse drag pans the zoomed picture, and the browser's own image drag would cancel it
				pictures[0] && (
					<img src={pictures[0].imageUrl} alt={pictures[0].alt} loading="lazy" decoding="async" draggable="false" />
				)
			}
			<p class="viewer-error" hidden>This image couldn’t load. Try its source below.</p>
		</div>
		<figcaption></figcaption>
	</figure>
	<div class="viewer-nav">
		<button type="button" data-viewer-prev>Previous picture</button>
		<button type="button" data-viewer-next>Next picture</button>
	</div>
</dialog>

<script>
	import { type Box, backdropBox } from "../lib/backdrop";

	// Arrows and dots are built here, so a page without JavaScript has no dead buttons.
	const strip = document.querySelector<HTMLElement>("[data-slides]");
	const slides = strip ? [...strip.querySelectorAll<HTMLElement>(".slide")] : [];
	if (strip && slides.length > 1) {
		const reduce = matchMedia("(prefers-reduced-motion: reduce)");
		const last = slides.length - 1;
		// every slide is one strip wide
		const current = () => Math.round(strip.scrollLeft / strip.clientWidth);
		const go = (i: number) =>
			strip.scrollTo({
				left: Math.max(0, Math.min(last, i)) * strip.clientWidth,
				behavior: reduce.matches ? "auto" : "smooth",
			});
		const button = (cls: string, label: string, text: string) => {
			const b = document.createElement("button");
			b.type = "button";
			b.className = cls;
			b.setAttribute("aria-label", label);
			b.textContent = text;
			return b;
		};
		const prev = button("arrow prev", "Previous picture", "Previous");
		const next = button("arrow next", "Next picture", "Next");
		const dots = document.createElement("div");
		dots.className = "dots";
		const dot = slides.map((_, i) => {
			const d = button("dot", `Picture ${i + 1} of ${slides.length}`, "");
			d.addEventListener("click", () => go(i));
			dots.appendChild(d);
			return d;
		});
		const sync = () => {
			const at = current();
			dot.forEach((d, i) => {
				if (i === at) d.setAttribute("aria-current", "true");
				else d.removeAttribute("aria-current");
			});
			prev.disabled = at === 0;
			next.disabled = at === last;
		};
		prev.addEventListener("click", () => go(current() - 1));
		next.addEventListener("click", () => go(current() + 1));
		strip.addEventListener("scroll", sync, { passive: true });
		strip.addEventListener("keydown", (e) => {
			if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
			e.preventDefault();
			go(current() + (e.key === "ArrowRight" ? 1 : -1));
		});
		const controls = document.createElement("div");
		controls.className = "picture-controls";
		for (const control of [prev, dots, next]) controls.appendChild(control);
		strip.parentElement?.appendChild(controls);
		strip.closest(".pic")?.classList.add("has-controls");
		sync();
	}

	const viewer = document.querySelector<HTMLDialogElement>(".picture-viewer");
	const image = viewer?.querySelector("img");
	const caption = viewer?.querySelector("figcaption");
	const stage = viewer?.querySelector<HTMLElement>(".viewer-stage");
	const count = viewer?.querySelector(".viewer-count");
	const error = viewer?.querySelector<HTMLElement>(".viewer-error");
	const zoom = viewer?.querySelector<HTMLButtonElement>("[data-viewer-zoom]");
	const close = viewer?.querySelector<HTMLButtonElement>("[data-viewer-close]");
	const prev = viewer?.querySelector<HTMLButtonElement>("[data-viewer-prev]");
	const next = viewer?.querySelector<HTMLButtonElement>("[data-viewer-next]");
	if (viewer && image && caption && stage && count && error && zoom && close && prev && next) {
		const reduce = matchMedia("(prefers-reduced-motion: reduce)");
		let at = 0;
		let opener: HTMLAnchorElement;
		let previewUrl = "";
		// The picture's box is k times the stage, so k = 1 shows the whole picture.
		// "framed" crops plain backdrop around a small subject; "zoomed" is the reader's own zoom.
		let k = 1;
		let mode: "" | "framed" | "zoomed" = "";
		let framing: { box: Box; ratio: number } | null = null;
		const labels = { "": "Zoom in", framed: "Whole picture", zoomed: "Fit picture" };
		// a live region: writing the same text again would announce it again
		const counted = () => {
			const text = `${at + 1} of ${slides.length}${mode === "framed" ? ", backdrop cropped" : ""}`;
			if (count.textContent !== text) count.textContent = text;
		};
		const set = (next: typeof mode, scale: number, left = 0, top = 0) => {
			mode = next;
			k = scale;
			stage.classList.toggle("framed", mode === "framed");
			stage.classList.toggle("zoomed", mode === "zoomed");
			stage.style.setProperty("--k", String(k));
			stage.scrollTo(left, top);
			zoom.textContent = labels[mode];
			zoom.toggleAttribute("data-zoomed", mode !== "");
			counted();
		};
		const fit = () => set("", 1);
		// zoom to `scale`, keeping the stage point (x, y) under the pointer
		const zoomAt = (scale: number, x = stage.clientWidth / 2, y = stage.clientHeight / 2) =>
			set("zoomed", scale, (stage.scrollLeft + x) * (scale / k) - x, (stage.scrollTop + y) * (scale / k) - y);
		// fill about 88% of the stage with the subject, centred; no more than 3 times the fit
		const frame = () => {
			if (!framing || mode === "zoomed") return;
			const { box, ratio } = framing;
			const [W, H] = [stage.clientWidth, stage.clientHeight];
			if (!W || !H) return;
			const fw = Math.min(W, H * ratio);
			const fh = fw / ratio;
			const scale = Math.min((0.88 * W) / (box.w * fw), (0.88 * H) / (box.h * fh), 3);
			if (scale < 1.15) return mode === "framed" ? fit() : undefined;
			const [dw, dh] = [scale * fw, scale * fh];
			set(
				"framed",
				scale,
				(scale * W - dw) / 2 + (box.x + box.w / 2) * dw - W / 2,
				(scale * H - dh) / 2 + (box.y + box.h / 2) * dh - H / 2,
			);
		};
		// a 64px copy is enough to find the backdrop; a host without CORS fails the load, so no crop
		let view = 0;
		const findSubject = (src: string, token: number) => {
			let url: URL;
			try {
				url = new URL(src);
			} catch {
				return;
			}
			const probe = new Image();
			probe.crossOrigin = "anonymous";
			probe.addEventListener("load", () => {
				// hidden: the preview failed, so there is nothing on screen to frame
				if (token !== view || !viewer.open || mode !== "" || image.hidden) return;
				const scale = 64 / Math.max(probe.naturalWidth, probe.naturalHeight);
				const canvas = document.createElement("canvas");
				canvas.width = Math.max(1, Math.round(probe.naturalWidth * scale));
				canvas.height = Math.max(1, Math.round(probe.naturalHeight * scale));
				const context = canvas.getContext("2d", { willReadFrequently: true });
				try {
					context?.drawImage(probe, 0, 0, canvas.width, canvas.height);
					const pixels = context?.getImageData(0, 0, canvas.width, canvas.height);
					const box = pixels && backdropBox(pixels.data, canvas.width, canvas.height);
					if (!box) return;
					framing = { box, ratio: probe.naturalWidth / probe.naturalHeight };
					frame();
				} catch {
					// tainted canvas: the whole picture stays in view
				}
			});
			// the strip loaded this preview without CORS, and that cached copy fails a CORS request
			url.searchParams.set("viewer", "1");
			probe.src = url.href;
		};
		new ResizeObserver(() => {
			if (mode === "framed") frame();
		}).observe(stage);
		const show = (index: number) => {
			if (index < 0 || index >= slides.length) return;
			const moved = index !== at;
			const token = ++view;
			at = index;
			const source = slides[at].querySelector("img");
			const link = slides[at].querySelector<HTMLAnchorElement>(".picture-open");
			const credit = slides[at].querySelector("figcaption");
			if (!source || !credit) return;
			framing = null;
			fit();
			error.hidden = true;
			image.hidden = false;
			zoom.disabled = false;
			image.alt = source.alt;
			// the preview is already on screen, so it shows at once; the original replaces it once loaded
			previewUrl = source.currentSrc || source.src;
			image.src = previewUrl;
			const original = link?.href ?? previewUrl;
			if (original !== previewUrl) {
				const full = new Image();
				full.addEventListener("load", () => {
					if (token !== view) return;
					// the original can arrive after the preview failed
					image.src = original;
					image.hidden = false;
					error.hidden = true;
					zoom.disabled = false;
				});
				full.src = original;
			}
			findSubject(previewUrl, token);
			// the neighbours' previews are lazy in the strip; ask for them now
			for (const i of [at - 1, at + 1]) {
				const neighbour = slides[i]?.querySelector("img");
				if (neighbour) neighbour.loading = "eager";
			}
			if (moved && !reduce.matches) {
				image.animate({ opacity: [0, 1] }, { duration: 240, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
			}
			const captionHadFocus = caption.contains(document.activeElement);
			caption.replaceChildren(...[...credit.childNodes].map((node) => node.cloneNode(true)));
			caption.querySelector("details")?.removeAttribute("open");
			const originalLink = document.createElement("a");
			originalLink.href = original;
			originalLink.textContent = "Open original";
			const line = caption.querySelector(".picture-credit");
			line?.appendChild(document.createTextNode(" · "));
			line?.appendChild(originalLink);
			counted();
			if (captionHadFocus || (document.activeElement === prev && at === 0) ||
				(document.activeElement === next && at === slides.length - 1)) {
				stage.focus({ preventScroll: true });
			}
			prev.disabled = at === 0;
			next.disabled = at === slides.length - 1;
		};
		slides.forEach((slide, i) => {
			const link = slide.querySelector<HTMLAnchorElement>(".picture-open");
			link?.addEventListener("click", (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				opener = link;
				// the viewer grows out of the picture that was opened
				const from = link.getBoundingClientRect();
				viewer.style.setProperty("--from-x", `${from.left + from.width / 2}px`);
				viewer.style.setProperty("--from-y", `${from.top + from.height / 2}px`);
				at = i;
				show(i);
				viewer.showModal();
				close.focus();
			});
		});
		close.addEventListener("click", () => viewer.close());
		viewer.addEventListener("close", () => opener?.focus({ preventScroll: true }));
		prev.addEventListener("click", () => show(at - 1));
		next.addEventListener("click", () => show(at + 1));
		zoom.addEventListener("click", () => {
			if (mode !== "") return fit();
			zoomAt(2);
			stage.focus({ preventScroll: true });
		});
		// a click on the picture zooms in at that point, and out again; a drag pans instead
		let drag: { x: number; y: number; moved: boolean } | null = null;
		let dragged = false;
		stage.addEventListener("pointerdown", (event) => {
			dragged = false;
			if (event.pointerType === "mouse" && event.button === 0 && mode === "zoomed") {
				drag = { x: event.clientX, y: event.clientY, moved: false };
				stage.setPointerCapture(event.pointerId);
			}
		});
		stage.addEventListener("pointermove", (event) => {
			if (!drag) return;
			const [dx, dy] = [event.clientX - drag.x, event.clientY - drag.y];
			if (Math.abs(dx) + Math.abs(dy) > 4) drag.moved = true;
			stage.scrollBy(-dx, -dy);
			drag.x = event.clientX;
			drag.y = event.clientY;
		});
		// pointerup and then lostpointercapture both end a drag: only the first may set `dragged`
		const endDrag = () => {
			if (!drag) return;
			dragged = drag.moved;
			drag = null;
		};
		stage.addEventListener("pointerup", endDrag);
		stage.addEventListener("pointercancel", endDrag);
		// closing the viewer mid-drag releases the capture, and no pointerup follows
		stage.addEventListener("lostpointercapture", endDrag);
		stage.addEventListener("click", (event) => {
			if (dragged || image.hidden) return;
			if (mode === "zoomed") return fit();
			const box = stage.getBoundingClientRect();
			zoomAt(Math.min(Math.max(2.5, k * 1.5), 6), event.clientX - box.left, event.clientY - box.top);
		});
		viewer.addEventListener("keydown", (event) => {
			if (mode === "zoomed") return;
			if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
			event.preventDefault();
			show(at + (event.key === "ArrowRight" ? 1 : -1));
		});
		let touch: { x: number; y: number; id: number } | null = null;
		stage.addEventListener("pointerdown", (event) => {
			if (event.pointerType === "touch" && !touch && mode !== "zoomed") {
				touch = { x: event.clientX, y: event.clientY, id: event.pointerId };
			}
		});
		const cancelTouch = () => { touch = null; };
		stage.addEventListener("pointercancel", cancelTouch);
		stage.addEventListener("lostpointercapture", cancelTouch);
		window.addEventListener("blur", cancelTouch);
		viewer.addEventListener("close", cancelTouch);
		window.addEventListener("pointerup", (event) => {
			if (!touch || touch.id !== event.pointerId) return;
			const dx = event.clientX - touch.x;
			const dy = event.clientY - touch.y;
			touch = null;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
			// a swipe down puts the picture away, as in a phone's own photo viewer
			else if (dy > 80 && dy > Math.abs(dx) * 1.5) viewer.close();
		});
		image.addEventListener("error", () => {
			if (image.src !== previewUrl) {
				image.src = previewUrl;
				return;
			}
			fit();
			image.hidden = true;
			error.hidden = false;
			if (document.activeElement === zoom) stage.focus({ preventScroll: true });
			zoom.disabled = true;
		});
	}
</script>

<style>
	.picture-explanation {
		margin-top: 8px;
	}
	.picture-explanation summary {
		display: list-item;
		align-content: center;
	}
	.picture-explanation p {
		margin: 0 0 8px;
	}
</style>
