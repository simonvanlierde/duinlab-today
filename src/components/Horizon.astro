---
interface Props {
	/** Band above (0-4); the strip fades from its bottom colour into the next band's top colour. */
	from: number;
	dune?: boolean;
}
const { from, dune = false } = Astro.props;
---

<div class="hz" style={`--hf:var(--Z${from});--ht:var(--A${from + 1})`} aria-hidden="true">
	{
		dune && (
			<svg viewBox="0 0 390 56" preserveAspectRatio="none">
				<path d="M0 36 C50 26 90 16 150 24 S250 38 310 22 S370 14 390 20 V56 H0Z" opacity=".3" />
				<path d="M0 46 C60 38 120 36 190 42 S320 46 390 36 V56 H0Z" />
			</svg>
		)
	}
</div>
