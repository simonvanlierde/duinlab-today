---
import { site } from "../lib/config";
import "../styles/global.css";
import Dune from "../components/Dune.astro";
import Foot from "../components/Foot.astro";
import { PHASE_SUN, SKY, skyAt } from "../components/sky";
import { sunAltitude } from "../lib/sun";

// Set in astro.config.mjs: the first 8 hex of the SHA-256 of public/og.png.
declare const __OG_VERSION__: string;

interface Props {
  title: string;
  description: string;
  /** Override the current sky for a missing page. */
  sky?: "day" | "night";
}
const { title, description, sky } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const now = Date.now();
const s = sky
  ? skyAt(PHASE_SUN[sky].alt, true, SKY)
  : skyAt(
      sunAltitude(now, site.location.latitude, site.location.longitude),
      sunAltitude(now + 600000, site.location.latitude, site.location.longitude) >
        sunAltitude(now, site.location.latitude, site.location.longitude),
      SKY,
    );
const style = Object.entries(s.vars)
  .map(([k, v]) => `${k}:${v}`)
  .join(";");
---

<!doctype html>
<html lang="en" data-ground={s.dark ? "dark" : "light"} style={style}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		{Astro.response.status !== 404 && (
			<>
				<meta property="og:type" content="website" />
				<meta property="og:site_name" content={site.site.title} />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:url" content={canonical} />
				<meta property="og:image" content={`${site.site.url}/og.png?v=${__OG_VERSION__}`} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content={site.site.description} />
				<meta name="twitter:card" content="summary_large_image" />
			</>
		)}
	</head>
	<body>
		<nav class="bar" aria-label="Site">
			<span class="wrap bar-in">
				<a href="/">{site.site.title}</a>
			</span>
		</nav>
		<header class="sky sky-slim">
			<div class="wrap mast"><h1><slot name="title" /></h1></div>
			<Dune />
		</header>
		<main class="wrap prose" id="paper">
			<slot />
		</main>
		<Foot><a href="/">Today's paper</a> &middot;</Foot>
	</body>
</html>
